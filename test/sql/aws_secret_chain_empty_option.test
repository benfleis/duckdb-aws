# name: aws_secret_chain_empty_option.test
# description: test aws ext option controlling behavior on empty secret chain
# group: [sql]

require aws

require httpfs

# require-env S3_TEST_SERVER_AVAILABLE 1

# Note this test is not very intelligent since we dont assume any profiles to be available

# test default setting (= true)
statement error
CREATE SECRET s1 (
    TYPE AWS,
    PROVIDER credential_chain
);
----
Invalid input

# set & test explicit setting = true
statement ok
SET aws__error_on_empty_secret_create = true;

statement error
CREATE SECRET s1 (
    TYPE AWS,
    PROVIDER credential_chain
);
----
Invalid input

query I
SELECT count(*) FROM secrets WHERE name='aws';
----
0

# set & test explicit setting = false
statement ok
SET aws__error_on_empty_secret_create = false;

statement ok
CREATE SECRET s1 (
    TYPE AWS,
    PROVIDER credential_chain
);

query I
SELECT count(*) FROM secrets WHERE name='aws';
----
1

